# ==============================================================================
# RYHAD TIC-MEDIC — TEMPLATE VARIABLES D'ENVIRONNEMENT (.env.example)
# Configuration complète et dynamique pour déploiement Coolify / VPS / Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES POSTGRESQL (Coolify Postgres ou Supabase/Neon)
# ------------------------------------------------------------------------------
# Connexion poolée (Transaction mode - 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connexion directe (Session mode - 5432 - pour les migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. DOMAINE & AUTHENTIFICATION (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="https://ryhad.2krmarket.online"
NEXT_PUBLIC_APP_URL="https://ryhad.2krmarket.online"
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET="votre_cle_secrete_aleatoire_32_caracteres"
AUTH_SECRET="votre_cle_secrete_aleatoire_32_caracteres"

# ------------------------------------------------------------------------------
# 3. IDENTITÉ & COORDONNÉES DE L'ENTREPRISE (Centralisées & Dynamiques)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_COMPANY_NAME="RyHaD Tic-Medic"
NEXT_PUBLIC_COMPANY_SHORT_NAME="RyHaD"
NEXT_PUBLIC_COMPANY_TAGLINE="Maintenance & Solutions Tech à Cotonou"
NEXT_PUBLIC_COMPANY_ADDRESS="Gbégamey, rue avant le collège Clé de la réussite, Cotonou, Bénin"
NEXT_PUBLIC_COMPANY_SHORT_ADDRESS="Gbégamey, Cotonou, Bénin"
NEXT_PUBLIC_COMPANY_CITY="Cotonou"
NEXT_PUBLIC_COMPANY_COUNTRY="Bénin"
NEXT_PUBLIC_COMPANY_PHONE="+229 01 90 88 13 14"
NEXT_PUBLIC_COMPANY_PHONE_RAW="+2290190881314"
NEXT_PUBLIC_COMPANY_EMAIL="ryhadticmedic@gmail.com"
NEXT_PUBLIC_COMPANY_HOURS="Lundi – Vendredi, 9h – 20h"
NEXT_PUBLIC_COMPANY_WEBSITE_DISPLAY="ryhad.2krmarket.online"

# ------------------------------------------------------------------------------
# 4. EMAILS TRANSACTIONNELS (Resend API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="RyHaD Tic-Medic <notifications@ryhad.bj>"
NOTIFICATION_EMAIL="ryhadticmedic@gmail.com"

# ------------------------------------------------------------------------------
# 5. WEB PUSH NOTIFICATIONS (VAPID API - PWA)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ryhadticmedic@gmail.com"

# ------------------------------------------------------------------------------
# 6. STOCKAGE CLOUD (Cloudflare R2 / AWS S3 - Photos de pannes et documents)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ryhad-media"
R2_PUBLIC_URL="https://media.ryhad.bj"

# ------------------------------------------------------------------------------
# 7. ENVIRONNEMENT & PERFORMANCE
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
