# ==============================================================================
# RYHAD TIC-MEDIC — TEMPLATE VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================

# 1. Base de Données (PostgreSQL Neon / Supabase)
# DATABASE_URL : Connexion poolée recommandée pour Vercel/Serverless (ex: ep-xyz-pooler.eu-central-1.aws.neon.tech)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL : Connexion directe pour les migrations Prisma (ex: ep-xyz.eu-central-1.aws.neon.tech)
DIRECT_URL="postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# 2. Authentification (NextAuth / Auth.js)
NEXTAUTH_URL="https://www.ryhad.bj"
NEXT_PUBLIC_APP_URL="https://www.ryhad.bj"
NEXTAUTH_SECRET=""
AUTH_SECRET=""

# 3. Emails Transactionnels (Resend)
RESEND_API_KEY=""
EMAIL_FROM="RyHaD Tic-Medic <notifications@ryhad.bj>"
NOTIFICATION_EMAIL="ryhadticmedic@gmail.com"

# 4. Stockage Fichiers (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ryhad-media"
R2_PUBLIC_URL="https://media.ryhad.bj"

# 5. Configuration Générale
NODE_ENV="production"
NEXT_PUBLIC_SITE_NAME="RyHaD Tic-Medic"
NEXT_PUBLIC_COMPANY_PHONE="+229 01 90 88 13 14"
NEXT_PUBLIC_COMPANY_EMAIL="ryhadticmedic@gmail.com"
NEXT_PUBLIC_COMPANY_ADDRESS="Gbégamey, rue avant le collège Clé de la réussite, Cotonou, Bénin"
